{
  "$schema": "https://design-tokens.unlimit/v1.json",
  "name": "@unlimit/design-tokens",
  "version": "1.0.0",
  "convention": "CSS variable name derived as --{category}-{key}, e.g. color.brand-primary -> --color-brand-primary",

  "color": {
    "brand-primary":       "#5B6CFF",
    "brand-primary-hover": "#4A5AE8",

    "neutral-0":   "#FFFFFF",
    "neutral-100": "#F5F6FA",
    "neutral-200": "#E4E7EE",
    "neutral-400": "#9AA1B1",
    "neutral-600": "#5C6373",
    "neutral-900": "#171A22",

    "success": "#1FAD66",
    "warning": "#F2A93B",
    "danger":  "#E14B4B",
    "info":    "#3B8DF2",

    "background":       "#FFFFFF",
    "foreground":       "#171A22",
    "muted":            "#F5F6FA",
    "muted-foreground": "#5C6373",

    "border":        "#E4E7EE",
    "border-subtle": "#F5F6FA",
    "focus-ring":    "#5B6CFF"
  },

  "spacing": {
    "0":  "0px",
    "1":  "4px",
    "2":  "8px",
    "3":  "12px",
    "4":  "16px",
    "6":  "24px",
    "8":  "32px",
    "12": "48px"
  },

  "radius": {
    "none": "0",
    "sm":   "4px",
    "md":   "8px",
    "lg":   "12px",
    "full": "9999px"
  },

  "shadow": {
    "sm": "0 1px 2px rgba(23, 26, 34, 0.05)",
    "md": "0 4px 12px rgba(23, 26, 34, 0.08)",
    "lg": "0 12px 32px rgba(23, 26, 34, 0.12)"
  },

  "font-family": {
    "sans": "'Inter', -apple-system, system-ui, sans-serif",
    "mono": "'JetBrains Mono', ui-monospace, monospace"
  },

  "font-size": {
    "xs":   "12px",
    "sm":   "14px",
    "base": "16px",
    "lg":   "18px",
    "xl":   "20px",
    "2xl":  "24px"
  },

  "font-weight": {
    "regular":  "400",
    "medium":   "500",
    "semibold": "600",
    "bold":     "700"
  },

  "line-height": {
    "tight":  "1.2",
    "normal": "1.5"
  }
}
