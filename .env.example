# Anthropic API key — required
ANTHROPIC_API_KEY=your_api_key_here

# LLM model per pipeline stage (cost-aware: Haiku for extraction, Sonnet for reasoning)
MODEL_PARSER=claude-haiku-4-5
MODEL_ANALYZER=claude-sonnet-4-6
MODEL_GENERATOR=claude-sonnet-4-6
MODEL_JUDGE=claude-haiku-4-5

# Retry configuration
MAX_RETRIES=3

# Enable optional LLM-judge in Validator (5th LLM call, richer a11y scoring)
# Set to "true" to activate; default is deterministic-only validation
USE_LLM_JUDGE=false

# HTTP server port
PORT=3000
