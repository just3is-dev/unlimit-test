# Anthropic API key — required
ANTHROPIC_API_KEY=your_api_key_here

# LLM model per pipeline stage (cost-aware: Haiku for extraction, Sonnet for reasoning)
MODEL_PARSER=claude-haiku-4-5
MODEL_ANALYZER=claude-sonnet-4-6
MODEL_GENERATOR=claude-sonnet-4-6

# Retry configuration
MAX_SCHEMA_RETRIES=3      # schema validation retries per LLM call (SchemaRetry)
MAX_GENERATOR_RETRIES=1   # guard-feedback retries for Generator stage

# HTTP server port
PORT=3000
